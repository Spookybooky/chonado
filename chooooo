import os
import random
import time
import telebot
from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton

# ТОКЕН (от BotFather)
BOT_TOKEN = "9132537199:AAGF7QnaYCyiPGAH67euOIeh-jDVJ8dwTnQ"
bot = telebot.TeleBot(BOT_TOKEN)

# Генератор 6-7 буквенных имен
def generate_word():
    vowels = "aeiouy"
    consonants = "bcdfghjklmnpqrstvwxz"
    length = random.choice([6, 7])
    word = ""
    for i in range(length):
        if i % 2 == 0:
            word += random.choice(consonants)
        else:
            word += random.choice(vowels)
    return word

# Проверка доступности
def check_username(username):
    try:
        import requests
        r = requests.get(f"https://t.me/{username}", timeout=10)
        if r.status_code == 404:
            return True
        elif r.status_code == 429:
            return "BAN"
    except Exception:
        return None
    return False

# Обработчик команды /start
@bot.message_handler(commands=['start'])
def start_message(message):
    markup = InlineKeyboardMarkup()
    markup.add(InlineKeyboardButton("🎲 Искать 10 имен (6-7 букв)", callback_data="check"))
    bot.send_message(message.chat.id, "Привет! Жми кнопку, я поищу свободные юзернеймы.", reply_markup=markup)

# Обработчик нажатия на кнопку
@bot.callback_query_handler(func=lambda call: call.data == "check")
def callback_check(call):
    bot.answer_callback_query(call.id, "⏳ Ищу... Это займет около 15 секунд.")
    bot.edit_message_text(chat_id=call.message.chat.id, message_id=call.message.message_id, text="⏳ Ищу свободные имена...")
    
    free_names = []
    
    for _ in range(10):
        word = generate_word()
        result = check_username(word)
        
        if result == "BAN":
            bot.send_message(call.message.chat.id, "⚠️ Telegram выдал бан (429). Нужно подождать.")
            return
        elif result is True:
            free_names.append(word)
            
        time.sleep(1.5) # Пауза, чтобы не забанили
        
    if free_names:
        text = "✅ Найдены свободные:\n\n"
        for name in free_names:
            text += f"🔗 @{name}\n"
    else:
        text = "😔 В этой десятке свободных нет. Жми еще раз!"
        
    markup = InlineKeyboardMarkup()
    markup.add(InlineKeyboardButton("🔄 Ещё 10 имен", callback_data="check"))
    bot.edit_message_text(chat_id=call.message.chat.id, message_id=call.message.message_id, text=text, reply_markup=markup, disable_web_page_preview=True)

print("Бот запущен...")
bot.infinity_polling()
